/*
* Pipeline parameters
*/

manifest {
    name            = 'lipovsek-lab/qc-pipeline'
    description     = 'QC pipeline for mouse utricle single-cell data: cell calling, doublet detection, minimal filtering, dimensionality reduction, clustering and outlier removal.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '1.0.0'
}

params {
    // output directory
    outdir = "results"
    // absolute path to raw adata
    // (raw adata should contain all cells and all genes if running cellbender)
    raw_adata               = null
    // batch ID column name in obs
    batch                   = null
    // csv file for cell typing
    celltype_csv            = null
    // metadata for qc plotting
    metadata                = null
    // Skip cellbender for datasets after cell calling
    skip_cellbender         = true
    // Skip scSHC clustering (memory intensive)
    skip_scSHC              = false
    // CellBender: optional CSV with per-batch settings
    // (columns: batch, total_droplets_included, expected_cells).
    // Set to null to let CellBender estimate all values automatically.
    cellbender_csv          = null
    // Join adatas: optional CSV to join adatas after cellbender
    // as alternative entry point to workflow
    join_csv                = null
    // outlier removal params (workflows/outlier_removal.nf)
    // adata
    adata                   = null
    // clusters
    clusters                = null
    // descriptor
    descriptor              = null
    // csv paths
    csv_paths               = null
    // batch csv paths (optional: *_batch.csv files published by qc-pipeline)
    batch_csv_paths         = null
    // doublets
    doublets                = null
}

/*
* Containers setup
*/

apptainer {
    enabled    = true
    cacheDir   = "$HOME/.nextflow/apptainer"
    runOptions = "--writable-tmpfs"
}

/*
* Reporting
*/

report {
    enabled = true
}

/*
* Output settings
*/

outputDir = params.outdir
workflow.output.mode = 'copy'

/*
* Process settings
*/

includeConfig 'conf/base.config'

/*
* Profiles
*/

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    alldata {
        includeConfig 'conf/alldata.config'
    }
    postnatal {
        includeConfig 'conf/postnatal.config'
    }
    myriad {
        includeConfig 'conf/myriad.config'
    }
}
