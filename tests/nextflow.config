/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

params {
    // Not consumed by this pipeline (all test data is local under test/, not pulled
    // from nf-core's remote test-datasets repo) — set for nf-core lint compliance only.
    modules_testdata_base_path   = "${projectDir}/test/"
    pipelines_testdata_base_path = "${projectDir}/test/"
}
